// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Products {
  id                  String @id @unique @default(uuid())
  identification_code String @unique
  bar_code            String @unique
  name                String
  description         String
  tag                 String

  @@map("products")
}
